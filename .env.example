# Copy to .env (never commit it). docker compose reads it automatically.

# Chambers that take part in the daily draw and the syncs: senate, deputies or both.
# Do not add deputies until its source can read profiles.
CHOOSER_CHAMBERS=senate

# How often `jobs serve` checks what is due (Go duration).
JOBS_INTERVAL=15m

# Wait between two congressmen in a monthly sync (Go duration).
JOBS_PAUSE=500ms

# SQLite file. The Docker image already sets /data/congressmen.db.
# DB_PATH=data/congressmen.db
