{
	auto_https off
}

:80 {
	root * /site/current
	encode zstd gzip

	@immutable path /_app/immutable/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		root * /site/current
		@notFound expression {err.status_code} == 404
		rewrite @notFound /404.html
		file_server
	}
}
